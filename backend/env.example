# Variables d'environnement du serveur Sphere Solar (backend)
# Copie ce fichier, renseigne tes propres valeurs, et ne publie jamais la copie remplie.

# ── Authentification JWT ─────────────────────────────────────────────
JWT_SECRET=remplace-par-une-longue-chaine-aleatoire
JWT_EXPIRE_MINUTES=60

# ── Compte administrateur créé par « python -m app.seed » ───────────
SEED_ADMIN_EMAIL=admin@sphere-solar.local
SEED_ADMIN_PASSWORD=remplace-par-un-mot-de-passe-solide

# ── Broker MQTT ──────────────────────────────────────────────────────
# Par défaut : broker public de test, sans authentification ni TLS.
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
# Production : MQTT_TLS=1, port 8883, identifiants et certificat de l'autorité (CA)
MQTT_TLS=0
MQTT_CA_CERT=

# ── Assistant d'analyse (LLM, Ollama Cloud) ──────────────────────────
# Laisse OLLAMA_API_KEY vide pour désactiver l'assistant.
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_TIMEOUT=60
